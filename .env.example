# Neon pooled URL for Prisma Client and runtime queries
DATABASE_URL="postgresql://USER:PASSWORD@YOUR-ENDPOINT-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require&channel_binding=require"

# Neon direct (unpooled) URL for Prisma schema operations
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@YOUR-ENDPOINT.REGION.aws.neon.tech/DBNAME?sslmode=require&channel_binding=require"

NEXT_PUBLIC_APP_URL="https://mafia.example.com"
GAME_SERVICE_PORT=3003
